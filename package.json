{
    "name": "datalith",
    "type": "module",
    "version": "0.0.1",
    "scripts": {
        "dev": "astro dev",
        "start": "astro dev",
        "sync-docs": "node --env-file-if-exists=.env scripts/sync-docs.ts",
        "sync-assets": "node --env-file-if-exists=.env scripts/sync-assets.ts",
        "build-themes": "node scripts/build-themes.ts",
        "build-icons": "node scripts/build-icons.ts",
        "fetch-releases": "node --env-file-if-exists=.env scripts/fetch-releases.ts",
        "licenses:generate": "node scripts/licenses/generate.ts",
        "licenses:check": "node scripts/licenses/check.ts",
        "policies:generate": "policygen generate && node scripts/policies/generate.ts",
        "policies:check": "node scripts/policies/check.ts",
        "prebuild": "npm run sync-docs && npm run sync-assets && npm run build-icons && npm run build-themes && npm run fetch-releases",
        "build": "astro build",
        "preview": "astro preview",
        "test": "vp test",
        "check": "astro sync && vp check && stylelint \"src/styles/*.css\"",
        "lint": "vp lint && stylelint \"src/styles/*.css\"",
        "lint:fix": "vp lint --fix && stylelint --fix \"src/styles/*.css\"",
        "fmt": "vp fmt",
        "fmt:check": "vp fmt --check",
        "astro": "astro"
    },
    "dependencies": {
        "@astrojs/starlight": "^0.42.7",
        "astro": "^7.4.4",
        "d3-drag": "^3.0.0",
        "d3-force": "^3.0.0",
        "d3-selection": "^3.0.0",
        "d3-zoom": "^3.0.0",
        "dompurify": "^3.4.17",
        "marked": "^18.1.2",
        "sharp": "^0.35.5"
    },
    "devDependencies": {
        "@astrojs/compiler-rs": "^0.5.2",
        "@types/d3-drag": "^3.0.7",
        "@types/d3-force": "^3.0.10",
        "@types/d3-selection": "^3.0.12",
        "@types/d3-zoom": "^3.0.9",
        "generate-license-file": "4.2.5",
        "policygen": "^0.7.1",
        "stylelint": "^17.16.0",
        "stylelint-config-recess-order": "^7.9.0",
        "stylelint-config-standard": "^40.0.0",
        "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
        "vite-plus": "1.4.0"
    },
    "overrides": {
        "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
        "vitest": "5.0.5"
    },
    "devEngines": {
        "runtime": {
            "name": "node",
            "version": "^22.18.0 || ^24.11.0 || >=26.0.0",
            "onFail": "error"
        },
        "packageManager": {
            "name": "npm",
            "version": ">=10 <12",
            "onFail": "error"
        }
    },
    "allowScripts": {
        "fsevents@2.3.3": true
    }
}
