{
  "name": "datalith-site",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "sync-docs": "node --env-file-if-exists=.env scripts/sync-docs.mjs",
    "sync-assets": "node --env-file-if-exists=.env scripts/sync-assets.mjs",
    "build-themes": "node scripts/build-themes.mjs",
    "fetch-releases": "node --env-file-if-exists=.env scripts/fetch-releases.mjs",
    "prebuild": "npm run sync-docs && npm run sync-assets && npm run build-themes && npm run fetch-releases",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/starlight": "^0.41.7",
    "astro": "^7.1.6",
    "d3-force": "^3.0.0",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@types/d3-force": "^3.0.10"
  }
}
