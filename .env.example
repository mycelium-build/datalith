# Optional read-only token for the Datalith repository on GitHub.
# The repository is public, so local builds work without it.
# CI sets it to avoid API rate limits.
DATALITH_READ_TOKEN= # github_pat_...

# Optional: local application checkout, only to test uncommitted assets.
# Documentation always comes from the published release tags.
DATALITH_SOURCE_DIR=../datalith-app

# Optional: git ref for application assets only (documentation uses published releases).
DATALITH_SOURCE_REF=main
