# Read-only token for the (possibly private) Datalith repository on GitHub.
# Copy this file to `.env` and fill in the value.

# DATALITH_READ_TOKEN=github_pat_...
DATALITH_READ_TOKEN=

# Optional: override where the Datalith docs vault is imported from.
DATALITH_SOURCE_DIR=../datalith-app

# Optional: Datalith git ref to import documentation from when DATALITH_SOURCE_DIR is unset.
# DATALITH_SOURCE_REF=main
