# Read-only token for the (possibly private) Datalith repository on GitHub.
# Copy this file to `.env` and fill in the value.

# DATALITH_READ_TOKEN=github_pat_...
DATALITH_READ_TOKEN=

# Optional: local application checkout for assets and documentation.
# Documentation is exported from the release tags, never the working tree.
DATALITH_SOURCE_DIR=../datalith-app

# Optional: git ref for application assets only (documentation uses published releases).
# DATALITH_SOURCE_REF=main
