{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": ["local>mycelium-build/datalith-app//.github/renovate/preset"],
    "packageRules": [
        {
            "description": "Dependency versions appear in THIRD-PARTY-NOTICES.md: regenerate it.",
            "matchManagers": ["npm"],
            "postUpgradeTasks": {
                "commands": ["scripts/renovate-post-upgrade.sh"],
                "fileFilters": ["THIRD-PARTY-NOTICES.md"],
                "executionMode": "branch"
            }
        },
        {
            "description": "vite is both a devDependency and an override, with the same value: update them together or npm fails with EOVERRIDE.",
            "matchPackageNames": ["vite", "vite-plus", "vitest", "@voidzero-dev/**"],
            "groupName": "vite-plus",
            "separateMajorMinor": false,
            "commitMessagePrefix": "chore(deps):"
        }
    ]
}
