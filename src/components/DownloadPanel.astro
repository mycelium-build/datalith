---
import releaseData from '../data/releases.json';

const repositoryUrl = `https://github.com/${releaseData.repository}`;
const sourceReleases = releaseData.releases ?? [];
// Keep the two channels deliberately disjoint: stable downloads must never fall back to a RC.
const stableReleases = sourceReleases.filter((release) => release.prerelease === false);
const previewReleases = sourceReleases.filter((release) => release.prerelease === true);
const realStable = stableReleases[0];
const latestPreview = previewReleases[0];
const hasStableRelease = Boolean(realStable);
const stable = realStable;
const platforms = [
	{ id: 'macos', label: 'macOS', detail: 'Apple silicon', extension: '.dmg' },
	{ id: 'windows', label: 'Windows', detail: '64-bit', extension: '.exe' },
	{ id: 'linux', label: 'Linux', detail: 'x86_64', extension: '.AppImage' },
];
const nativeLinuxPackages = [
	{ id: 'linux-deb', label: 'Debian / Ubuntu', detail: 'x86_64', extension: '.deb' },
	{ id: 'linux-rpm', label: 'Fedora / RHEL', detail: 'x86_64', extension: '.rpm' },
	{ id: 'linux-arch', label: 'Arch Linux', detail: 'x86_64', extension: '.pkg.tar.zst' },
];
const version = (tagName) => tagName?.replace(/^v/, '') ?? '';
const asset = (release, platform) => release?.assets.find((item) => item.platform === platform);
---


<section class="download-prototype" data-download-panel>
	<div class="variant variant-c">
		<div class="compact-heading">
			<div><p class="overline">Desktop app</p><h3>{hasStableRelease ? `Datalith ${version(stable?.tagName)}` : 'Datalith'}</h3></div>
			<span class:list={["stable-badge", { unavailable: !hasStableRelease }]}>{hasStableRelease ? 'Stable' : 'Coming soon'}</span>
		</div>
		<div class="download-controls"><Fragment set:html={''} /></div>
	</div>

	<template data-controls-template>
		<div class="control-stack">
			<div class="primary-row">
				<a class="primary-download" data-stable-download href={asset(stable, 'macos')?.browserDownloadUrl}>
					<span class="platform-logo" data-current-logo aria-hidden="true"></span>
					<span><strong data-stable-label>Download for macOS</strong><small data-stable-meta>{version(stable?.tagName)} · Apple silicon · .dmg</small></span>
					<svg class="download-glyph" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 3v11m0 0 4-4m-4 4-4-4M5 18v1a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-1" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
				</a>
				<details class:list={["download-menu", "stable-menu", { disabled: !hasStableRelease }]}>
					<summary aria-disabled={String(!hasStableRelease)} tabindex={hasStableRelease ? undefined : '-1'}><span class="package-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><path d="m4 7 8-4 8 4-8 4-8-4Zm0 0v10l8 4 8-4V7M12 11v10" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round" /></svg></span>Other Packages <span aria-hidden="true">⌄</span></summary>
					<div class="menu-card"><p class="menu-title">Other packages{hasStableRelease ? ` · ${version(stable?.tagName)}` : ''}</p><div data-other-platforms></div></div>
				</details>
			</div>
			<div class="secondary-row">
				<details class="download-menu preview-menu">
					<summary><span class="spark" aria-hidden="true">✦</span> Download preview <span class="rc-badge">RC</span><span aria-hidden="true">⌄</span></summary>
					<div class="menu-card">
						<div class="preview-heading"><div><p class="menu-title">Preview {version(latestPreview?.tagName)}</p><small>Try upcoming features before release.</small></div><span class="rc-badge">RC</span></div>
						<div data-preview-platforms></div>
					</div>
				</details>
				<nav class="release-links" aria-label="Release links">
					<a href={`${repositoryUrl}/blob/main/CHANGELOG.md`} target="_blank" rel="noreferrer">Changelog <span aria-hidden="true">↗</span></a>
					<a href={`${repositoryUrl}/releases`} target="_blank" rel="noreferrer">All releases <span aria-hidden="true">↗</span></a>
				</nav>
			</div>
		</div>
	</template>

	<script type="application/json" data-download-data set:html={JSON.stringify({ stable, hasStableRelease, latestPreview, platforms, nativeLinuxPackages })}></script>
</section>

<script>
	const logos = {
		macos: '<svg viewBox="0 0 24 24"><path d="M16.8 12.8c0-2 1.6-3 1.7-3.1a3.8 3.8 0 0 0-3-1.6c-1.3-.1-2.5.8-3.1.8-.7 0-1.7-.8-2.8-.8a4.2 4.2 0 0 0-3.5 2.2c-1.5 2.6-.4 6.5 1 8.7.7 1.1 1.5 2.3 2.6 2.3 1 0 1.4-.7 2.7-.7s1.7.7 2.8.7 1.8-1.1 2.5-2.2c.8-1.2 1.1-2.4 1.1-2.5-.1 0-2-.8-2-3.8Zm-2-6c.6-.7 1-1.6.9-2.5-.8 0-1.8.5-2.4 1.2-.5.6-1 1.5-.9 2.4.9.1 1.8-.4 2.4-1.1Z"/></svg>',
		windows: '<svg viewBox="0 0 24 24"><path d="M2.5 4.6 10.7 3.5v7.7H2.5V4.6Zm9.5-1.3L21.5 2v9.2H12V3.3ZM2.5 12.5h8.2v7.8l-8.2-1.1v-6.7Zm9.5 0h9.5V22L12 20.7v-8.2Z"/></svg>',
		linux: '<img src="https://cdn.simpleicons.org/linux/000000" alt="" width="24" height="24" />',
		'linux-deb': '<img src="https://cdn.simpleicons.org/debian/000000" alt="" width="24" height="24" />',
		'linux-rpm': '<img src="https://cdn.simpleicons.org/fedora/000000" alt="" width="24" height="24" />',
		'linux-arch': '<img src="https://cdn.simpleicons.org/archlinux/000000" alt="" width="24" height="24" />',
	};
	const panel = document.querySelector('[data-download-panel]');
	if (panel) {
		const data = JSON.parse(panel.querySelector('[data-download-data]')?.textContent ?? '{}');
		const detectPlatform = () => {
			const agent = `${navigator.userAgentData?.platform ?? ''} ${navigator.platform ?? ''} ${navigator.userAgent}`.toLowerCase();
			if (agent.includes('win')) return 'windows';
			if (agent.includes('linux')) return 'linux';
			return 'macos';
		};
		const current = detectPlatform();
		const info = (id) => data.platforms.find((item) => item.id === id);
		const releaseAsset = (release, id) => release?.assets.find((item) => item.platform === id);
		const cleanVersion = (tag) => tag?.replace(/^v/, '') ?? '';
		const platformLink = (release, platform, isPreview = false, enabled = true) => {
			const item = releaseAsset(release, platform.id);
			if (!item) return '';
			const state = enabled ? `href="${item.browserDownloadUrl}"` : 'aria-disabled="true" tabindex="-1"';
			return `<a class="platform-option" ${state}><span class="platform-logo">${logos[platform.id]}</span><span><strong>${platform.label}</strong><small>${isPreview ? cleanVersion(release.tagName) + ' · ' : ''}${platform.detail} · ${platform.extension}</small></span><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 4v11m0 0 4-4m-4 4-4-4M5 20h14" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg></a>`;
		};
		const nativePackageGroup = (release, isPreview = false) => {
			const availablePackages = data.nativeLinuxPackages.filter((item) => releaseAsset(release, item.id));
			if (!availablePackages.length) return '';
			const versionMeta = isPreview ? `${cleanVersion(release.tagName)} · ` : '';
			const formatLabel = availablePackages.length === 1 ? 'format' : 'formats';
			return `<details class="native-package-menu"><summary class="platform-option"><span class="platform-logo">${logos.linux}</span><span><strong>Linux native packages</strong><small>${versionMeta}x86_64 · ${availablePackages.length} ${formatLabel}</small></span><svg class="submenu-chevron" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="m8 10 4 4 4-4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></summary><div class="native-package-options">${availablePackages.map((item) => platformLink(release, item, isPreview)).join('')}</div></details>`;
		};

		const template = panel.querySelector('[data-controls-template]');
		panel.querySelectorAll('.download-controls').forEach((slot) => slot.replaceChildren(template.content.cloneNode(true)));
		panel.querySelectorAll('[data-current-logo]').forEach((node) => node.innerHTML = logos[current]);
		const currentInfo = info(current);
		const stableAsset = releaseAsset(data.stable, current);
		panel.querySelectorAll('[data-stable-download]').forEach((link) => {
			if (data.hasStableRelease && stableAsset) {
				link.href = stableAsset.browserDownloadUrl;
				link.removeAttribute('aria-disabled');
				link.removeAttribute('tabindex');
			} else {
				link.removeAttribute('href');
				link.setAttribute('aria-disabled', 'true');
				link.setAttribute('tabindex', '-1');
			}
		});
		panel.querySelectorAll('[data-stable-label]').forEach((node) => node.textContent = data.hasStableRelease ? `Download for ${currentInfo.label}` : 'No stable release yet');
		panel.querySelectorAll('[data-stable-meta]').forEach((node) => node.textContent = data.hasStableRelease ? `${cleanVersion(data.stable.tagName)} · ${currentInfo.detail} · ${currentInfo.extension}` : 'Check back soon');
		panel.querySelectorAll('[data-other-platforms]').forEach((list) => {
			list.innerHTML = data.platforms.filter((platform) => platform.id !== current).map((platform) => platformLink(data.stable, platform, false, data.hasStableRelease)).join('') + nativePackageGroup(data.stable);
		});
		panel.querySelectorAll('[data-preview-platforms]').forEach((list) => {
			list.innerHTML = data.latestPreview ? data.platforms.map((platform) => platformLink(data.latestPreview, platform, true)).join('') + nativePackageGroup(data.latestPreview, true) : '<p class="empty-state">No preview available.</p>';
		});

		panel.addEventListener('toggle', (event) => {
			if (!event.target.matches('.download-menu') || !event.target.open) return;
			panel.querySelectorAll('.download-menu[open]').forEach((details) => { if (details !== event.target) details.removeAttribute('open'); });
		}, true);
		panel.querySelectorAll('.stable-menu.disabled').forEach((menu) => {
			menu.addEventListener('click', (event) => event.preventDefault());
		});
	}
</script>

<style>
	.download-prototype { --border: color-mix(in srgb, var(--landing-text) 15%, transparent); --muted: color-mix(in srgb, var(--landing-text) 64%, transparent); color: var(--landing-text); position: relative; }
	.variant { border: 1px solid var(--border); border-radius: 1.4rem; box-shadow: 0 1.5rem 4rem #001b3d12; min-height: 22rem; padding: clamp(1.5rem, 5vw, 3rem); }
	.variant h3 { color: var(--landing-heading); font-size: clamp(1.8rem, 4vw, 2.6rem); letter-spacing: -.05em; margin: 0; }
	.variant p { color: var(--muted); }
	.control-stack { display: grid; gap: 1rem; max-width: 39rem; }
	.primary-row, .secondary-row { align-items: flex-start; display: flex; flex-wrap: wrap; gap: .65rem; }
	.primary-download { align-items: center; background: var(--landing-heading); border-radius: .8rem; color: #fff; display: flex; gap: .8rem; min-width: 18.5rem; padding: .8rem 1rem; text-decoration: none; transition: transform .2s, background .2s; }
	.primary-download:hover, .primary-download:focus-visible { background: var(--landing-accent-strong); transform: translateY(-1px); }
	.primary-download[aria-disabled="true"] { background: color-mix(in srgb, var(--landing-text) 28%, var(--landing-surface)); color: color-mix(in srgb, var(--landing-text) 48%, transparent); cursor: not-allowed; pointer-events: none; transform: none; }
	.primary-download[aria-disabled="true"] small { color: inherit; }
	.primary-download > span:nth-child(2) { display: grid; gap: .08rem; }
	.primary-download strong { font-size: .9rem; }
	.primary-download small { color: #ffffffb8; font-size: .72rem; }
	.platform-logo { align-items: center; display: inline-flex; flex: 0 0 auto; height: 1.45rem; justify-content: center; width: 1.45rem; }
	.platform-logo svg { fill: currentColor; height: 100%; width: 100%; }
	.platform-logo img { filter: grayscale(1); height: 100%; width: 100%; }
	.download-glyph { height: 1.15rem; margin-left: auto; width: 1.15rem; }
	.download-menu { position: relative; }
	.download-menu > summary { align-items: center; background: color-mix(in srgb, var(--landing-text) 7%, transparent); border: 1px solid transparent; border-radius: .8rem; color: var(--landing-heading); cursor: pointer; display: flex; font-size: .84rem; font-weight: 700; gap: .5rem; list-style: none; min-height: 3.65rem; padding: .75rem 1rem; }
	.download-menu > summary::-webkit-details-marker { display: none; }
	.download-menu > summary:hover, .download-menu > summary:focus-visible, .download-menu[open] > summary { background: color-mix(in srgb, var(--landing-accent) 10%, transparent); border-color: color-mix(in srgb, var(--landing-accent) 28%, transparent); }
	.package-icon { display: inline-flex; height: 1.2rem; width: 1.2rem; }
	.package-icon svg { height: 100%; width: 100%; }
	.download-menu.disabled > summary { background: color-mix(in srgb, var(--landing-text) 5%, transparent); border-color: transparent; color: color-mix(in srgb, var(--landing-text) 38%, transparent); cursor: not-allowed; }
	.menu-card { background: var(--landing-surface); border: 1px solid var(--border); border-radius: .85rem; box-shadow: 0 1.1rem 2.5rem #001b3d26; left: 0; min-width: 20rem; padding: .65rem; position: absolute; top: calc(100% + .45rem); z-index: 10; }
	.menu-title { color: var(--landing-heading) !important; font-size: .7rem; font-weight: 800; letter-spacing: .08em; margin: .35rem .45rem .55rem; text-transform: uppercase; }
	:global(.platform-option) { align-items: center; border-radius: .6rem; color: var(--landing-heading); display: flex; gap: .75rem; padding: .65rem; text-decoration: none; }
	:global(.platform-option:hover), :global(.platform-option:focus-visible) { background: color-mix(in srgb, var(--landing-accent) 10%, transparent); }
	:global(.platform-option[aria-disabled="true"]) { color: color-mix(in srgb, var(--landing-text) 38%, transparent); cursor: not-allowed; pointer-events: none; }
	:global(.platform-option > span:nth-child(2)) { display: grid; gap: .1rem; }
	:global(.platform-option strong) { font-size: .85rem; }
	:global(.platform-option small), .preview-heading small { color: var(--muted); font-size: .7rem; }
	:global(.platform-option > svg) { height: 1rem; margin-left: auto; width: 1rem; }
	:global(.platform-option .platform-logo) { align-items: center; display: inline-flex; flex: 0 0 auto; height: 1.45rem; justify-content: center; width: 1.45rem; }
	:global(.platform-option .platform-logo svg) { fill: currentColor; height: 100%; width: 100%; }
	:global(.platform-option .platform-logo img) { filter: grayscale(1); height: 100%; width: 100%; }
	:global(.native-package-menu) { border-top: 1px solid var(--border); margin-top: .25rem; padding-top: .25rem; }
	:global(.native-package-menu > summary) { cursor: pointer; list-style: none; }
	:global(.native-package-menu > summary::-webkit-details-marker) { display: none; }
	:global(.native-package-menu > summary:hover), :global(.native-package-menu > summary:focus-visible), :global(.native-package-menu[open] > summary) { background: color-mix(in srgb, var(--landing-accent) 10%, transparent); }
	:global(.native-package-menu .submenu-chevron) { transition: transform .18s ease; }
	:global(.native-package-menu[open] .submenu-chevron) { transform: rotate(180deg); }
	:global(.native-package-options) { border-left: 1px solid var(--border); margin: .2rem 0 .2rem 1.35rem; padding-left: .45rem; }
	.rc-badge, .stable-badge { background: #f2a4291a; border: 1px solid #e4982544; border-radius: 999px; color: #9b5b00; font-size: .62rem; font-weight: 800; padding: .16rem .38rem; }
	.spark { color: #9b5b00; }
	.preview-heading { align-items: flex-start; display: flex; justify-content: space-between; padding: .15rem .35rem .55rem; }
	.preview-heading .menu-title { margin-left: .1rem; margin-bottom: .12rem; }
	.release-links { align-items: center; display: flex; gap: 1rem; min-height: 3.65rem; }
	.release-links a { color: var(--muted); font-size: .78rem; font-weight: 650; text-decoration: none; }
	.release-links a:hover { color: var(--landing-heading); text-decoration: underline; }
	.overline { color: var(--landing-accent-strong) !important; font-size: .72rem; font-weight: 800; letter-spacing: .1em; margin: 0 0 .8rem; text-transform: uppercase; }
	.variant-c { background: var(--landing-surface); min-height: 0; }
	.compact-heading { align-items: center; border-bottom: 1px solid var(--border); display: flex; justify-content: space-between; margin-bottom: 1.3rem; padding-bottom: 1.2rem; }
	.compact-heading .overline { margin-bottom: .35rem; }
	.compact-heading h3 { font-size: 1.5rem; }
	.stable-badge { background: #20a76916; border-color: #20a76940; color: #147548; }
	.stable-badge.unavailable { background: color-mix(in srgb, var(--landing-text) 7%, transparent); border-color: var(--border); color: var(--muted); }
	.variant-c .control-stack { max-width: none; }
	.variant-c .primary-row { flex-wrap: nowrap; }
	.variant-c .primary-download { flex: 1; }
	.variant-c .secondary-row { justify-content: space-between; }
	@media (max-width: 36rem) {
		.variant { padding: 1.25rem; }
		.primary-row, .secondary-row, .variant-c .primary-row { display: grid; }
		.primary-download, .download-menu, .download-menu > summary { min-width: 0; width: 100%; }
		.menu-card { min-width: min(20rem, calc(100vw - 4rem)); right: 0; }
		.release-links { flex-wrap: wrap; }
	}
</style>
