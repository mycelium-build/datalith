---
import releaseData from "../data/releases.json";
import Icon from "./Icon.astro";

const repositoryUrl = `https://github.com/${releaseData.repository}`;
const sourceReleases = releaseData.releases ?? [];
// Keep the two channels deliberately disjoint: stable downloads must never fall back to a RC.
const stableReleases = sourceReleases.filter(
    (release) => release.prerelease === false,
);
const previewReleases = sourceReleases.filter(
    (release) => release.prerelease === true,
);
const realStable = stableReleases[0];
const latestPreview = previewReleases[0];
const hasStableRelease = Boolean(realStable);
const stable = realStable;
const platforms = [
    { id: "macos", label: "macOS", detail: "Apple silicon", extension: ".dmg" },
    { id: "windows", label: "Windows", detail: "64-bit", extension: ".exe" },
    { id: "linux", label: "Linux", detail: "x86_64", extension: ".AppImage" },
];
const version = (tagName: string) => tagName?.replace(/^v/, "") ?? "";
const asset = (release, platform) =>
    release?.assets.find((item) => item.platform === platform);
---

<section class="download-prototype" data-download-panel>
    <div class="variant variant-c">
        <div class="compact-heading">
            <div>
                <p class="overline">Desktop app</p><h3>
                    {
                        hasStableRelease
                            ? `Datalith ${version(stable?.tagName)}`
                            : "Datalith"
                    }
                </h3>
            </div>
            <span
                class:list={[
                    "stable-badge",
                    { unavailable: !hasStableRelease },
                ]}>{hasStableRelease ? "Stable" : "Coming soon"}</span
            >
        </div>
        <div class="download-controls"><Fragment set:html={""} /></div>
    </div>

    <template data-controls-template>
        <div class="control-stack">
            <div class="primary-row">
                <a
                    class="primary-download"
                    data-stable-download
                    href={asset(stable, "macos")?.browserDownloadUrl}
                >
                    <span
                        class="platform-logo"
                        data-current-logo
                        aria-hidden="true"></span>
                    <span
                        ><strong data-stable-label>Download for macOS</strong
                        ><small data-stable-meta
                            >{version(stable?.tagName)} · Apple silicon · .dmg</small
                        ></span
                    >
                    <Icon name="download" class="download-glyph" />
                </a>
                <details
                    class:list={[
                        "download-menu",
                        "stable-menu",
                        { disabled: !hasStableRelease },
                    ]}
                >
                    <summary
                        aria-disabled={String(!hasStableRelease)}
                        tabindex={hasStableRelease ? undefined : "-1"}
                        >Other platforms <Icon name="chevronDown" /></summary
                    >
                    <div class="menu-card">
                        <p class="menu-title">
                            Other platforms{
                                hasStableRelease
                                    ? ` · ${version(stable?.tagName)}`
                                    : ""
                            }
                        </p><div data-other-platforms></div>
                    </div>
                </details>
            </div>
            <div class="secondary-row">
                <details class="download-menu preview-menu">
                    <summary
                        ><span class="spark" aria-hidden="true">✦</span> Download
                        preview <span class="rc-badge">RC</span><Icon
                            name="chevronDown"
                        /></summary
                    >
                    <div class="menu-card">
                        <div class="preview-heading">
                            <div>
                                <p class="menu-title">
                                    Preview {version(latestPreview?.tagName)}
                                </p><small
                                    >Try upcoming features before release.</small
                                >
                            </div><span class="rc-badge">RC</span>
                        </div>
                        <div data-preview-platforms></div>
                    </div>
                </details>
                <nav class="release-links" aria-label="Release links">
                    <a
                        href={`${repositoryUrl}/blob/main/CHANGELOG.md`}
                        target="_blank"
                        rel="noreferrer"
                        >Changelog <Icon name="arrowUpRight" /></a
                    >
                    <a
                        href={`${repositoryUrl}/releases`}
                        target="_blank"
                        rel="noreferrer"
                        >All releases <Icon name="arrowUpRight" /></a
                    >
                </nav>
            </div>
        </div>
    </template>

    <script
        type="application/json"
        data-download-data
        set:html={JSON.stringify({
            stable,
            hasStableRelease,
            latestPreview,
            platforms,
        })}
    />
</section>

<script>
    import downloadIcon from "../assets/icons/download.svg?raw";
    const logos = {
        macos: '<svg viewBox="0 0 24 24"><path d="M16.8 12.8c0-2 1.6-3 1.7-3.1a3.8 3.8 0 0 0-3-1.6c-1.3-.1-2.5.8-3.1.8-.7 0-1.7-.8-2.8-.8a4.2 4.2 0 0 0-3.5 2.2c-1.5 2.6-.4 6.5 1 8.7.7 1.1 1.5 2.3 2.6 2.3 1 0 1.4-.7 2.7-.7s1.7.7 2.8.7 1.8-1.1 2.5-2.2c.8-1.2 1.1-2.4 1.1-2.5-.1 0-2-.8-2-3.8Zm-2-6c.6-.7 1-1.6.9-2.5-.8 0-1.8.5-2.4 1.2-.5.6-1 1.5-.9 2.4.9.1 1.8-.4 2.4-1.1Z"/></svg>',
        windows:
            '<svg viewBox="0 0 24 24"><path d="M2.5 4.6 10.7 3.5v7.7H2.5V4.6Zm9.5-1.3L21.5 2v9.2H12V3.3ZM2.5 12.5h8.2v7.8l-8.2-1.1v-6.7Zm9.5 0h9.5V22L12 20.7v-8.2Z"/></svg>',
        linux: '<img src="https://cdn.simpleicons.org/linux/000000" alt="" width="24" height="24" />',
    };
    const panel = document.querySelector("[data-download-panel]");
    if (panel) {
        const data = JSON.parse(
            panel.querySelector("[data-download-data]")?.textContent ?? "{}",
        );
        const detectPlatform = () => {
            const agent =
                `${navigator.userAgentData?.platform ?? ""} ${navigator.platform ?? ""} ${navigator.userAgent}`.toLowerCase();
            if (agent.includes("win")) return "windows";
            if (agent.includes("linux")) return "linux";
            return "macos";
        };
        const current = detectPlatform();
        const info = (id) => data.platforms.find((item) => item.id === id);
        const releaseAsset = (release, id) =>
            release?.assets.find((item) => item.platform === id);
        const cleanVersion = (tag) => tag?.replace(/^v/, "") ?? "";
        const platformLink = (
            release,
            platform,
            isPreview = false,
            enabled = true,
        ) => {
            const item = releaseAsset(release, platform.id);
            if (!item) return "";
            const state = enabled
                ? `href="${item.browserDownloadUrl}"`
                : 'aria-disabled="true" tabindex="-1"';
            return `<a class="platform-option" ${state}><span class="platform-logo">${logos[platform.id]}</span><span><strong>${platform.label}</strong><small>${isPreview ? cleanVersion(release.tagName) + " · " : ""}${platform.detail} · ${platform.extension}</small></span>${downloadIcon}</a>`;
        };

        const template = panel.querySelector("[data-controls-template]");
        panel
            .querySelectorAll(".download-controls")
            .forEach((slot) =>
                slot.replaceChildren(template.content.cloneNode(true)),
            );
        panel
            .querySelectorAll("[data-current-logo]")
            .forEach((node) => (node.innerHTML = logos[current]));
        const currentInfo = info(current);
        const stableAsset = releaseAsset(data.stable, current);
        panel.querySelectorAll("[data-stable-download]").forEach((link) => {
            if (data.hasStableRelease && stableAsset) {
                link.href = stableAsset.browserDownloadUrl;
                link.removeAttribute("aria-disabled");
                link.removeAttribute("tabindex");
            } else {
                link.removeAttribute("href");
                link.setAttribute("aria-disabled", "true");
                link.setAttribute("tabindex", "-1");
            }
        });
        panel
            .querySelectorAll("[data-stable-label]")
            .forEach(
                (node) =>
                    (node.textContent = data.hasStableRelease
                        ? `Download for ${currentInfo.label}`
                        : "No stable release yet"),
            );
        panel
            .querySelectorAll("[data-stable-meta]")
            .forEach(
                (node) =>
                    (node.textContent = data.hasStableRelease
                        ? `${cleanVersion(data.stable.tagName)} · ${currentInfo.detail} · ${currentInfo.extension}`
                        : "Check back soon"),
            );
        panel.querySelectorAll("[data-other-platforms]").forEach((list) => {
            list.innerHTML = data.platforms
                .filter((platform) => platform.id !== current)
                .map((platform) =>
                    platformLink(
                        data.stable,
                        platform,
                        false,
                        data.hasStableRelease,
                    ),
                )
                .join("");
        });
        panel.querySelectorAll("[data-preview-platforms]").forEach((list) => {
            list.innerHTML = data.latestPreview
                ? data.platforms
                      .map((platform) =>
                          platformLink(data.latestPreview, platform, true),
                      )
                      .join("")
                : '<p class="empty-state">No preview available.</p>';
        });

        panel.addEventListener(
            "toggle",
            (event) => {
                if (!event.target.open) return;
                panel.querySelectorAll("details[open]").forEach((details) => {
                    if (details !== event.target)
                        details.removeAttribute("open");
                });
            },
            true,
        );
        panel.querySelectorAll(".stable-menu.disabled").forEach((menu) => {
            menu.addEventListener("click", (event) => event.preventDefault());
        });
    }
</script>

<style>
    .download-prototype {
        --muted: color-mix(in srgb, var(--dl-fg) 60%, transparent);
        color: var(--dl-fg);
    }

    .variant {
        background: var(--dl-surface);
        border: 1px solid var(--dl-border);
        min-height: 0;
        padding: clamp(1.5rem, 5vw, 2.5rem);

        h3 {
            font-family: var(--font-pixel);
            font-size: clamp(1.5rem, 3vw, 2.2rem);
            line-height: 1.1;
            margin: 0;
        }

        p {
            color: var(--muted);
        }
    }

    .control-stack {
        display: grid;
        gap: 1rem;
        max-width: 39rem;
    }

    .primary-row,
    .secondary-row {
        align-items: flex-start;
        display: flex;
        flex-wrap: wrap;
        gap: 0.65rem;
    }

    .primary-download {
        align-items: center;
        background: var(--dl-accent);
        box-sizing: border-box;
        color: var(--dl-accent-fg);
        display: flex;
        font-family: var(--font-pixel);
        font-weight: 700;
        gap: 0.8rem;
        height: 3.65rem;
        min-width: 18.5rem;
        padding: 0 1rem;
        text-decoration: none;
        transition:
            background 0.12s,
            transform 0.06s steps(2, jump-none);

        strong,
        small {
            white-space: nowrap;
        }

        &:hover,
        &:focus-visible {
            background: color-mix(in srgb, var(--dl-accent) 82%, #000 18%);
        }
        &:active {
            transform: translate(2px, 2px);
        }
        &[aria-disabled="true"] {
            background: var(--dl-surface-alt);
            color: color-mix(in srgb, var(--dl-fg) 45%, var(--dl-muted));
            cursor: not-allowed;
            pointer-events: none;
            transform: none;

            strong {
                color: inherit;
            }
            small {
                color: color-mix(in srgb, var(--dl-fg) 40%, var(--dl-muted));
            }
        }

        > span:nth-child(2) {
            display: grid;
            gap: 0.08rem;
        }

        strong {
            font-family: var(--font-sans);
            font-size: 0.9rem;
            font-weight: 700;
        }
        small {
            color: color-mix(in srgb, var(--dl-accent-fg) 75%, transparent);
            font-size: 0.72rem;
            font-weight: 400;
        }
    }

    .platform-logo {
        align-items: center;
        display: inline-flex;
        flex: 0 0 auto;
        height: 1.45rem;
        justify-content: center;
        width: 1.45rem;

        svg {
            fill: currentColor;
            height: 100%;
            width: 100%;
        }
        img {
            filter: grayscale(1);
            height: 100%;
            width: 100%;
        }
    }

    .download-glyph {
        font-size: 21px;
        margin-left: auto;
    }
    .download-menu {
        position: relative;

        summary {
            align-items: center;
            background: var(--dl-surface-alt);
            color: var(--dl-fg);
            cursor: pointer;
            display: flex;
            font-size: 0.84rem;
            font-weight: 700;
            gap: 0.5rem;
            list-style: none;
            min-height: 3.65rem;
            padding: 0.75rem 1rem;

            .pixel-icon {
                font-size: 14px;
            }

            &::-webkit-details-marker {
                display: none;
            }
        }
        summary:hover,
        summary:focus-visible,
        &[open] summary {
            background: color-mix(
                in srgb,
                var(--dl-accent) 16%,
                var(--dl-surface-alt)
            );
        }

        &.disabled summary {
            background: var(--dl-surface-alt);
            color: color-mix(in srgb, var(--dl-fg) 55%, var(--dl-muted));
            cursor: not-allowed;
        }
    }

    .menu-card {
        background: var(--dl-surface);
        left: 0;
        min-width: 20rem;
        padding: 0.65rem;
        position: absolute;
        top: calc(100% + 0.45rem);
        z-index: 10;
    }

    .menu-title {
        color: var(--dl-fg) !important;
        font-size: 0.7rem;
        font-weight: 800;
        letter-spacing: 0.08em;
        margin: 0.35rem 0.45rem 0.55rem;
        text-transform: uppercase;
    }

    :global(.platform-option) {
        align-items: center;
        color: var(--dl-fg);
        display: flex;
        gap: 0.75rem;
        padding: 0.65rem;
        text-decoration: none;
    }
    :global(.platform-option:hover),
    :global(.platform-option:focus-visible) {
        background: color-mix(in srgb, var(--dl-accent) 12%, transparent);
    }
    :global(.platform-option[aria-disabled="true"]) {
        color: color-mix(in srgb, var(--dl-fg) 38%, transparent);
        cursor: not-allowed;
        pointer-events: none;
    }
    :global(.platform-option > span:nth-child(2)) {
        display: grid;
        gap: 0.1rem;
    }
    :global(.platform-option strong) {
        font-size: 0.85rem;
    }
    :global(.platform-option small),
    .preview-heading small {
        color: var(--muted);
        font-size: 0.7rem;
    }
    :global(.platform-option > svg) {
        height: 14px;
        margin-left: auto;
        width: 14px;
    }
    :global(.platform-option .platform-logo) {
        align-items: center;
        display: inline-flex;
        flex: 0 0 auto;
        height: 1.45rem;
        justify-content: center;
        width: 1.45rem;
    }
    :global(.platform-option .platform-logo svg) {
        fill: currentColor;
        height: 100%;
        width: 100%;
    }
    :global(.platform-option .platform-logo img) {
        filter: grayscale(1);
        height: 100%;
        width: 100%;
    }

    .rc-badge,
    .stable-badge {
        background: color-mix(in srgb, var(--dl-yellow) 18%, transparent);
        color: var(--dl-yellow);
        font-size: 0.62rem;
        font-weight: 800;
        padding: 0.16rem 0.38rem;
    }

    .spark {
        color: var(--dl-yellow);
    }

    .preview-heading {
        align-items: flex-start;
        display: flex;
        justify-content: space-between;
        padding: 0.15rem 0.35rem 0.55rem;

        .menu-title {
            margin-bottom: 0.12rem;
            margin-left: 0.1rem;
        }
    }

    .release-links {
        align-items: center;
        display: flex;
        gap: 1rem;
        min-height: 3.65rem;

        a {
            color: var(--muted);
            font-size: 0.78rem;
            font-weight: 650;
            text-decoration: none;

            .pixel-icon {
                font-size: 14px;
            }

            &:hover {
                color: var(--dl-fg);
                text-decoration: underline;
            }
        }
    }

    .overline {
        color: var(--dl-accent) !important;
        font-size: 0.72rem;
        font-weight: 800;
        letter-spacing: 0.1em;
        margin: 0 0 0.8rem;
        text-transform: uppercase;
    }

    .compact-heading {
        align-items: center;
        display: flex;
        justify-content: space-between;
        margin-bottom: 1.3rem;
        padding-bottom: 1.2rem;

        .overline {
            margin-bottom: 0.35rem;
        }

        h3 {
            font-size: 1.5rem;
        }
    }

    .stable-badge {
        background: color-mix(in srgb, var(--dl-green) 18%, transparent);
        color: var(--dl-green);

        &.unavailable {
            background: var(--dl-surface-alt);
            color: color-mix(in srgb, var(--dl-fg) 45%, var(--dl-muted));
        }
    }

    .variant-c {
        background: var(--dl-surface);

        .control-stack {
            max-width: none;
        }

        .primary-row {
            flex-wrap: nowrap;
        }
        .primary-download {
            flex: 1;
        }

        .secondary-row {
            justify-content: space-between;
        }
    }

    @media (max-width: 36rem) {
        .variant {
            padding: 1.25rem;
        }
        .primary-row,
        .secondary-row,
        .variant-c .primary-row {
            display: grid;
        }
        .primary-download,
        .download-menu,
        .download-menu summary {
            min-width: 0;
            width: 100%;
        }
        .menu-card {
            min-width: min(20rem, calc(100vw - 4rem));
            right: 0;
        }
        .release-links {
            flex-wrap: wrap;
        }
    }
</style>
