<section class="md-widget" data-md-widget>
    <div class="md-toolbar">
        <div class="md-modes" role="group" aria-label="Editor mode">
            <button type="button" class="is-active" data-md-mode="write">Write</button>
            <button type="button" data-md-mode="preview">Preview</button>
        </div>
    </div>
    <div class="md-body">
        <textarea data-md-input spellcheck="false" aria-label="Markdown editor">
            # Welcome to Datalith A **local-first** workspace for the files that matter. ## Try it -
            Write with Markdown, [[formats/Markdown|plain text]] - Link notes together with
            [[Basics|wiki links]] - Visualize them in the [[formats/Graph|graph view]] > Type here,
            the preview updates as you write. ```md Everything stays a plain file on your machine.
            ```
        </textarea>
        <div class="md-preview md-prose" data-md-preview hidden></div>
    </div>
</section>

<script>
    import { docUrl } from "../lib/route"
    import searchData from "../data/search.json"
    import { normalizeTarget, renderMarkdown } from "../lib/markdown"

    const root = document.querySelector("[data-md-widget]")
    if (!root) throw new Error("markdown widget missing host")
    const input = root.querySelector<HTMLTextAreaElement>("[data-md-input]")!
    const preview = root.querySelector<HTMLElement>("[data-md-preview]")!
    const modes = [...root.querySelectorAll<HTMLButtonElement>("[data-md-mode]")]

    const byPath = new Map(
        searchData.documents.map((doc) => [
            doc.route
                .replace(/^\/docs\/vault\//, "")
                .replace(/\/$/, "")
                .toLowerCase(),
            doc.route,
        ]),
    )
    const byTitle = new Map(searchData.documents.map((doc) => [doc.title.toLowerCase(), doc.route]))

    function resolver(target: string): string | null {
        const route =
            byPath.get(normalizeTarget(target)) ?? byTitle.get(normalizeTarget(target)) ?? null
        return route ? docUrl(route) : null
    }

    function render() {
        preview.innerHTML = renderMarkdown(input.value, resolver)
    }

    function setMode(mode: "write" | "preview") {
        const isWrite = mode === "write"
        input.hidden = !isWrite
        preview.hidden = isWrite
        for (const button of modes)
            button.classList.toggle("is-active", button.dataset.mdMode === mode)
        if (!isWrite) render()
    }

    for (const button of modes)
        button.addEventListener("click", () =>
            setMode(button.dataset.mdMode as "write" | "preview"),
        )
</script>

