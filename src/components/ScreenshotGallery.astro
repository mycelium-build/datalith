---
import { Image } from "astro:assets"

import covers from "../assets/screenshots/covers.avif"
import editor from "../assets/screenshots/editor.avif"
import graph from "../assets/screenshots/graph.avif"
import search from "../assets/screenshots/search.avif"
import table from "../assets/screenshots/table.avif"
import todo from "../assets/screenshots/todo.avif"
import welcome from "../assets/screenshots/welcome.avif"

const shots = [
    {
        id: "notes",
        label: "Notes",
        image: welcome,
        caption: "Markdown notes with properties and wiki links, beside your Vault's file tree.",
    },
    {
        id: "editor",
        label: "Editor",
        image: editor,
        caption: "Switch to the source: plain Markdown, highlighted as you write.",
    },
    {
        id: "search",
        label: "Search",
        image: search,
        caption: "Relevance-ranked results with highlighted matches, as you type.",
    },
    {
        id: "graph",
        label: "Graph",
        image: graph,
        caption: "A Base rendered as a graph of linked notes, colored by category.",
    },
    {
        id: "table",
        label: "Table",
        image: table,
        caption: "The same Base as a table, grouped by status with summaries per group.",
    },
    {
        id: "cards",
        label: "Cards",
        image: covers,
        caption: "Or as cards, each one carrying its cover.",
    },
    {
        id: "tasks",
        label: "Tasks",
        image: todo,
        caption: "A todo.txt file with priorities, projects, contexts and subtasks.",
    },
]
---

<div class="shots" data-shots>
    <div class="shots-tabs" role="tablist" aria-label="Screenshots">
        {shots.map((shot, i) => (
            <button
                type="button"
                role="tab"
                id={`shot-tab-${shot.id}`}
                aria-controls={`shot-${shot.id}`}
                aria-selected={i === 0 ? "true" : "false"}
                tabindex={i === 0 ? 0 : -1}
                data-shot-tab
            >
                {shot.label}
            </button>
        ))}
    </div>

    <div class="shots-stage">
        {shots.map((shot, i) => (
            <figure
                class="shot"
                role="tabpanel"
                id={`shot-${shot.id}`}
                aria-labelledby={`shot-tab-${shot.id}`}
                data-active={String(i === 0)}
                data-shot-panel
            >
                <Image
                    src={shot.image}
                    alt={`Datalith: ${shot.caption}`}
                    widths={[800, 1600, 2400, shot.image.width]}
                    sizes="(max-width: 74rem) 100vw, 68rem"
                    format="avif"
                    loading="lazy"
                />
                <figcaption>{shot.caption}</figcaption>
            </figure>
        ))}
    </div>
</div>

<script>
    for (const root of document.querySelectorAll<HTMLElement>("[data-shots]")) {
        const tabs = [...root.querySelectorAll<HTMLButtonElement>("[data-shot-tab]")]
        const panels = [...root.querySelectorAll<HTMLElement>("[data-shot-panel]")]

        const select = (index: number, focus = false) => {
            tabs.forEach((tab, i) => {
                const active = i === index
                tab.setAttribute("aria-selected", String(active))
                tab.tabIndex = active ? 0 : -1
                panels[i].dataset.active = String(active)
            })
            if (focus) tabs[index].focus()
        }

        tabs.forEach((tab, i) => {
            tab.addEventListener("click", () => select(i))
            tab.addEventListener("keydown", (event) => {
                const last = tabs.length - 1
                const next = {
                    ArrowRight: i === last ? 0 : i + 1,
                    ArrowLeft: i === 0 ? last : i - 1,
                    Home: 0,
                    End: last,
                }[event.key]
                if (next === undefined) return
                event.preventDefault()
                select(next, true)
            })
        })
    }
</script>

<style>
    .shots-tabs {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-2);
        justify-content: center;
        margin-bottom: var(--space-4);

        button {
            background: var(--dl-surface-alt);
            border: 0;
            color: var(--dl-muted);
            cursor: pointer;
            font: inherit;
            font-size: 0.85rem;
            font-weight: 700;
            padding: 0.45rem 0.85rem;
            transition: background 0.12s;

            &:hover {
                color: var(--dl-fg);
            }

            &[aria-selected="true"] {
                background: var(--dl-accent);
                color: var(--dl-accent-fg);
            }
        }
    }

    /* Every shot shares one grid cell, so switching never shifts the layout. */
    .shots-stage {
        display: grid;
    }

    .shot {
        grid-area: 1 / 1;
        margin: 0;
        opacity: 0;
        transition:
            opacity 0.2s steps(4, jump-none),
            visibility 0.2s;
        visibility: hidden;

        &[data-active="true"] {
            opacity: 1;
            visibility: visible;
        }

        img {
            display: block;
            height: auto;
            width: 100%;
        }

        figcaption {
            color: var(--dl-muted);
            font-size: 0.9rem;
            text-align: center;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .shot {
            transition: none;
        }
    }
</style>
