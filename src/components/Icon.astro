---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"span"> {
    name: string;
}

// This file is generated by scripts/build-icons.mjs — do not edit directly.
const icons: Record<string, string> = {
    arrowDownAZ: (await import("../assets/icons/arrow-down-a-z.svg?raw")).default,
    arrowDown: (await import("../assets/icons/arrow-down.svg?raw")).default,
    arrowLeft: (await import("../assets/icons/arrow-left.svg?raw")).default,
    arrowRight: (await import("../assets/icons/arrow-right.svg?raw")).default,
    arrowUpAZ: (await import("../assets/icons/arrow-up-a-z.svg?raw")).default,
    arrowUpRight: (await import("../assets/icons/arrow-up-right.svg?raw")).default,
    arrowUp: (await import("../assets/icons/arrow-up.svg?raw")).default,
    bolt: (await import("../assets/icons/bolt.svg?raw")).default,
    check: (await import("../assets/icons/check.svg?raw")).default,
    chevronDown: (await import("../assets/icons/chevron-down.svg?raw")).default,
    chevronLeft: (await import("../assets/icons/chevron-left.svg?raw")).default,
    chevronRight: (await import("../assets/icons/chevron-right.svg?raw")).default,
    chevronUp: (await import("../assets/icons/chevron-up.svg?raw")).default,
    close: (await import("../assets/icons/close.svg?raw")).default,
    download: (await import("../assets/icons/download.svg?raw")).default,
    eye: (await import("../assets/icons/eye.svg?raw")).default,
    file: (await import("../assets/icons/file.svg?raw")).default,
    folderOpen: (await import("../assets/icons/folder-open.svg?raw")).default,
    folder: (await import("../assets/icons/folder.svg?raw")).default,
    funnel: (await import("../assets/icons/funnel.svg?raw")).default,
    gear: (await import("../assets/icons/gear.svg?raw")).default,
    graph: (await import("../assets/icons/graph.svg?raw")).default,
    image: (await import("../assets/icons/image.svg?raw")).default,
    inbox: (await import("../assets/icons/inbox.svg?raw")).default,
    layoutDashboard: (await import("../assets/icons/layout-dashboard.svg?raw")).default,
    lock: (await import("../assets/icons/lock.svg?raw")).default,
    moon: (await import("../assets/icons/moon.svg?raw")).default,
    note: (await import("../assets/icons/note.svg?raw")).default,
    palette: (await import("../assets/icons/palette.svg?raw")).default,
    pen: (await import("../assets/icons/pen.svg?raw")).default,
    plus: (await import("../assets/icons/plus.svg?raw")).default,
    search: (await import("../assets/icons/search.svg?raw")).default,
    star: (await import("../assets/icons/star.svg?raw")).default,
    sun: (await import("../assets/icons/sun.svg?raw")).default,
    todo: (await import("../assets/icons/todo.svg?raw")).default,
};

const { name, class: className, ...rest } = Astro.props;
const source = icons[name] ?? "";
---

<span class:list={["pixel-icon", className]} set:html={source} {...rest} />

<style>
    .pixel-icon {
        align-items: center;
        display: inline-flex;
        flex: 0 0 auto;
        justify-content: center;
        line-height: 0;

        :global(svg) {
            height: 1em;
            width: 1em;
        }
    }
</style>
