---
import "../styles/base.css"
import "../styles/themes.css"

import DownloadPanel from "../components/DownloadPanel.astro"
import GraphWidget from "../components/GraphWidget.astro"
import Icon from "../components/Icon.astro"
import MarkdownWidget from "../components/MarkdownWidget.astro"
import MonolithLogo from "../components/MonolithLogo.astro"
import SearchWidget from "../components/SearchWidget.astro"
import ThemePicker from "../components/ThemePicker.astro"
import TodoWidget from "../components/TodoWidget.astro"

import stars from "../data/stars.json"
import { themeInitScript } from "../../scripts/theme-init.ts"

const baseUrl = import.meta.env.BASE_URL
const docsUrl = `${baseUrl.replace(/\/$/, "")}/docs/vault/welcome/`
const githubUrl = "https://github.com/mycelium-build/datalith"
const starCount = Number(stars.stargazersCount ?? 0)
---

<!doctype html>
<html lang="en" data-datalith-theme="datalith-light" data-mode="light">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <meta
            name="description"
            content="Datalith is a fast, local-first Vault for notes, tasks and linked ideas. Search, visualize, and keep them in a private encyclopedia that lasts."
        />
        <link rel="icon" type="image/png" href={`${baseUrl}datalith.png`} />
        <title>Datalith · From pixels to knowledge</title>
        <script is:inline set:html={themeInitScript} />
    </head>
    <body>
        <div class="page-shell">
            <header class="site-header">
                <a class="brand" href={baseUrl}>Datalith</a>
                <nav aria-label="Main navigation">
                    <a href={docsUrl}>Documentation</a>
                    <a class="github-link" href={githubUrl} target="_blank" rel="noreferrer">
                        <Icon name="star" />
                        <span>GitHub</span>
                        {
                            starCount > 0 && (
                                <span class="star-count" aria-label={`${starCount} stars`}>
                                    {starCount}
                                </span>
                            )
                        }
                    </a>
                </nav>
            </header>

            <main>
                <section class="hero" aria-label="Datalith">
                    <div class="hero-grid">
                        <div class="hero-logo" aria-hidden="true">
                            <MonolithLogo cell={9} />
                        </div>
                        <div class="hero-copy">
                            <p class="eyebrow">A personal encyclopedia</p>
                            <h1 class="display">
                                From pixel to<br /><em>knowledge.</em>
                            </h1>
                            <p class="hero-sub">
                                A local-first Vault where notes, links, and tasks sharpen into a
                                monolith that lasts.
                            </p>
                            <div class="hero-actions">
                                <a class="pixel-button" href="#download"
                                    ><Icon name="download" /><span>Download Datalith</span></a
                                >
                                <a class="hero-link" href={docsUrl}>Documentation</a>
                                <a
                                    class="hero-link external"
                                    href={githubUrl}
                                    target="_blank"
                                    rel="noreferrer">GitHub <Icon name="arrowUpRight" /></a
                                >
                            </div>
                        </div>
                    </div>
                </section>

                <section class="intro" aria-label="About Datalith">
                    <div class="intro-panel">
                        <span class="corner corner-tl" aria-hidden="true"></span>
                        <span class="corner corner-tr" aria-hidden="true"></span>
                        <span class="corner corner-bl" aria-hidden="true"></span>
                        <span class="corner corner-br" aria-hidden="true"></span>
                        <div class="intro-copy">
                            <p class="eyebrow">A little magic</p>
                            <h2 class="display">
                                The enchanted monolith<br />that remembers.
                            </h2>
                            <p>
                                Datalith is a monolith, enchanted to find and visualize every note
                                you have ever written. A note is a pixel, a link between two notes
                                another. Tend them, and the picture sharpens into focus: a private
                                personal encyclopedia, one of a kind, built to outlast any app,
                                service, or trend.
                            </p>
                        </div>
                    </div>
                </section>

                <section class="download-section" id="download" aria-labelledby="download-heading">
                    <div class="section-heading">
                        <p class="eyebrow">Start today</p>
                        <h2 class="display" id="download-heading">Begin your encyclopedia.</h2>
                        <p>
                            Download Datalith and lay the first pixel of your own knowledge. Free,
                            open source, for macOS, Windows, and Linux.
                        </p>
                    </div>
                    <DownloadPanel />
                </section>

                <section class="bento" aria-label="Datalith features">
                    <div class="bento-col">
                        <article class="bento-tile tile-fast">
                            <div class="tile-head">
                                <Icon name="bolt" class="tile-glyph" />
                                <div>
                                    <h2 class="display">Instant, every time</h2>
                                    <p>
                                        Opens in a blink, even on Vaults of 10k+ notes.<br />
                                        So reading and writing never wait on you.
                                    </p>
                                </div>
                            </div>
                        </article>

                        <article class="bento-tile tile-md">
                            <header class="tile-head">
                                <Icon name="note" />
                                <div>
                                    <h2 class="display">Write in Markdown</h2>
                                    <p>Notes with preview, wiki links, and properties.</p>
                                </div>
                            </header>
                            <MarkdownWidget />
                        </article>

                        <article class="bento-tile tile-todo">
                            <header class="tile-head">
                                <Icon name="todo" />
                                <div>
                                    <h2 class="display">Tasks that stay files</h2>
                                    <p>A real todo.txt editor: priorities, projects, subtasks.</p>
                                </div>
                            </header>
                            <TodoWidget />
                        </article>

                        <article class="bento-tile tile-local">
                            <div class="tile-head">
                                <Icon name="folder" class="tile-glyph" />
                                <div>
                                    <h2 class="display">Local first</h2>
                                    <p>
                                        Your Vault is a folder you own, with open format files that
                                        outlive apps.<br />
                                        Your encyclopedia can never be taken from you.
                                    </p>
                                </div>
                            </div>
                        </article>
                    </div>

                    <div class="bento-col">
                        <article class="bento-tile tile-search">
                            <header class="tile-head">
                                <Icon name="search" />
                                <div>
                                    <h2 class="display">Every thought, findable</h2>
                                    <p>
                                        Relevance-ranked search across names and content, as you
                                        type.<br />
                                        The right note surfaces even when you only half-remember it.
                                    </p>
                                </div>
                            </header>
                            <SearchWidget />
                        </article>

                        <article class="bento-tile tile-graph">
                            <header class="tile-head">
                                <Icon name="graph" />
                                <div>
                                    <h2 class="display">Ideas, connected by design</h2>
                                    <p>
                                        Wiki links become a living graph.<br />
                                        Follow a thread and rediscover what you forgot you knew.
                                    </p>
                                </div>
                            </header>
                            <GraphWidget />
                        </article>

                        <article class="bento-tile tile-theme">
                            <header class="tile-head">
                                <Icon name="palette" />
                                <div>
                                    <h2 class="display">Make it yours</h2>
                                    <p>
                                        Dozens of themes, light and dark.<br />
                                        Knowledge shaped into a familiar place is easier to come back
                                        to.
                                    </p>
                                </div>
                            </header>
                            <ThemePicker variant="full" />
                        </article>

                        <article class="bento-tile tile-private">
                            <div class="tile-head">
                                <Icon name="lock" class="tile-glyph" />
                                <div>
                                    <h2 class="display">Private by default</h2>
                                    <p>Your files never leave your machine.</p>
                                </div>
                            </div>
                        </article>
                    </div>
                </section>

                <section class="open-source" aria-label="Open source">
                    <div>
                        <p class="eyebrow">Open source</p>
                        <h2 class="display">MIT-licensed. Star it on GitHub.</h2>
                    </div>
                    <a class="pixel-button" href={githubUrl} target="_blank" rel="noreferrer">
                        <Icon name="star" />
                        <span>Star on GitHub</span>
                        {
                            starCount > 0 && (
                                <span class="star-count-inverse" aria-label={`${starCount} stars`}>
                                    {starCount}
                                </span>
                            )
                        }
                    </a>
                </section>

                <section class="final-cta" aria-label="Download Datalith">
                    <div class="final-cta-mark" aria-hidden="true">
                        <MonolithLogo cell={6} />
                    </div>
                    <div class="final-cta-copy">
                        <p class="eyebrow">Ready to begin?</p>
                        <h2 class="display">Plant your monolith in a folder of your own.</h2>
                        <p>
                            One download, one empty folder and a lifetime of knowledge sharpens into
                            focus.
                        </p>
                    </div>
                    <a class="pixel-button" href="#download">
                        <Icon name="download" />
                        <span>Download Datalith</span>
                    </a>
                </section>
            </main>

            <footer class="site-footer">
                <span>© {new Date().getFullYear()} Datalith</span>
                <span>Built pixel by pixel.</span>
            </footer>
        </div>
    </body>
</html>

<style>
    html {
        scroll-behavior: smooth;
    }

    .hero {
        align-content: center;
        display: grid;
        min-height: calc(100vh - 5rem);
        padding: clamp(2rem, 6vw, 5rem) 0;
    }
    .hero-grid {
        align-items: center;
        display: grid;
        gap: clamp(2rem, 5vw, 4rem);
        grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.4fr);
    }
    .hero-logo {
        display: flex;
        justify-content: center;
        justify-self: center;
        width: min(64vw, 32rem);
        animation: float 3.6s ease-in-out infinite;
    }
    @keyframes float {
        0%,
        100% {
            transform: translateY(0);
        }
        50% {
            transform: translateY(-1.1rem);
        }
    }
    .hero-copy h1 {
        font-size: clamp(2.2rem, 5vw, 4.2rem);
        margin: 0;

        em {
            color: var(--dl-accent);
            font-style: normal;
        }
    }
    .hero-sub {
        color: var(--dl-muted);
        font-size: clamp(1rem, 2vw, 1.18rem);
        line-height: 1.6;
        margin: 1.4rem 0 0;
        max-width: 30rem;
    }
    .hero-actions {
        align-items: center;
        display: flex;
        flex-wrap: wrap;
        gap: 1.6rem;
        margin-top: 2rem;
    }
    .hero-link {
        align-items: center;
        color: var(--dl-muted);
        display: inline-flex;
        font-size: 0.92rem;
        font-weight: 600;
        gap: 0.3rem;

        .pixel-icon {
            font-size: 14px;
        }

        &:hover,
        &:focus-visible {
            color: var(--dl-fg);
        }
    }
    .github-link {
        align-items: center;
        display: inline-flex;
        gap: 0.4rem;

        .pixel-icon {
            color: var(--dl-yellow);
            font-size: 14px;
        }
    }
    .star-count {
        background: var(--dl-surface-alt);
        font-size: 0.72rem;
        font-weight: 700;
        padding: 0.12rem 0.4rem;
    }

    .intro {
        padding: clamp(3rem, 7vw, 5.5rem) 0;
    }
    .intro-panel {
        background: var(--dl-surface);
        border: 1px solid var(--dl-border);
        padding: clamp(1.75rem, 4vw, 2.75rem) clamp(1.25rem, 3vw, 2.5rem);
        position: relative;
        text-align: center;
    }
    .corner {
        background: var(--dl-accent);
        height: 4px;
        position: absolute;
        width: 4px;
    }
    .corner-tl {
        box-shadow:
            0 4px 0 0 var(--dl-accent),
            0 8px 0 0 var(--dl-accent),
            4px 0 0 0 var(--dl-accent),
            8px 0 0 0 var(--dl-accent);
        left: -4px;
        top: -4px;
    }
    .corner-tr {
        box-shadow:
            0 4px 0 0 var(--dl-accent),
            0 8px 0 0 var(--dl-accent),
            -4px 0 0 0 var(--dl-accent),
            -8px 0 0 0 var(--dl-accent);
        right: -4px;
        top: -4px;
    }
    .corner-bl {
        bottom: -4px;
        box-shadow:
            0 -4px 0 0 var(--dl-accent),
            0 -8px 0 0 var(--dl-accent),
            4px 0 0 0 var(--dl-accent),
            8px 0 0 0 var(--dl-accent);
        left: -4px;
    }
    .corner-br {
        bottom: -4px;
        box-shadow:
            0 -4px 0 0 var(--dl-accent),
            0 -8px 0 0 var(--dl-accent),
            -4px 0 0 0 var(--dl-accent),
            -8px 0 0 0 var(--dl-accent);
        right: -4px;
    }
    .intro-copy {
        margin-inline: auto;
        max-width: 44rem;

        h2 {
            font-size: clamp(1.6rem, 3.5vw, 2.4rem);
            margin: 0 0 1rem;
        }

        p {
            color: var(--dl-muted);
            line-height: 1.65;
            margin-inline: auto;
            max-width: 42rem;
        }

        p + p {
            margin-top: 0.85rem;
        }

        p:last-child {
            margin-bottom: 0;
        }
    }

    .download-section {
        padding: clamp(3rem, 7vw, 5.5rem) 0;
    }
    .section-heading {
        margin-bottom: var(--space-6);

        h2 {
            font-size: clamp(1.8rem, 4vw, 2.8rem);
            margin: 0 0 0.6rem;
        }

        p:last-child {
            color: var(--dl-muted);
            margin: 0;
        }
    }

    .bento {
        display: flex;
        gap: var(--space-4);
        padding-bottom: clamp(3rem, 7vw, 5.5rem);
    }
    .bento-col {
        display: flex;
        flex: 1;
        flex-direction: column;
        gap: var(--space-4);
        min-width: 0;
    }
    .bento-tile {
        background: var(--dl-surface);
        border: 1px solid var(--dl-border);
        display: flex;
        flex-direction: column;
        min-width: 0;
        padding: var(--space-5);

        h2.display {
            font-size: 1.3rem;
            margin: 0 0 0.45rem;
        }

        p {
            color: var(--dl-muted);
            font-size: 0.86rem;
            line-height: 1.55;
            margin: 0;
        }

        .pixel-icon {
            flex: 0 0 auto;
        }
    }

    .tile-md,
    .tile-graph,
    .tile-todo {
        aspect-ratio: 1 / 1;
        max-height: 400px;
        min-height: 0;
        width: 100%;
    }
    .tile-todo {
        .todo-widget {
            flex-grow: 1;
        }
    }

    .tile-head {
        align-items: flex-start;
        display: flex;
        gap: 0.8rem;
        margin-bottom: 1rem;

        .pixel-icon {
            color: var(--dl-accent);
            font-size: 21px;
            flex: 0 0 auto;
            margin-top: 0.15rem;
        }

        h2 {
            font-size: 1.35rem;
            margin: 0 0 0.3rem;
        }

        p {
            color: var(--dl-muted);
            font-size: 0.85rem;
            line-height: 1.5;
            margin: 0;
        }

        &:last-child {
            margin-bottom: 0;
        }
    }

    .open-source {
        align-items: center;
        background: var(--dl-surface);
        border: 1px solid var(--dl-border);
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-5);
        justify-content: space-between;
        margin-bottom: clamp(3rem, 7vw, 5.5rem);
        padding: var(--space-6) var(--space-5);

        .eyebrow {
            margin-bottom: 0.3rem;
        }

        h2 {
            font-size: clamp(1.4rem, 3vw, 2rem);
            margin: 0;
        }
    }
    .star-count-inverse {
        background: color-mix(in srgb, #000 18%, transparent);
        font-size: 0.78rem;
        font-weight: 700;
        padding: 0.14rem 0.45rem;
    }

    .final-cta {
        align-items: center;
        background: var(--dl-surface);
        border: 1px solid var(--dl-border);
        display: grid;
        gap: clamp(1.5rem, 4vw, 3rem);
        grid-template-columns: minmax(0, auto) minmax(0, 1fr) minmax(0, auto);
        margin-bottom: clamp(3rem, 7vw, 5.5rem);
        padding: clamp(1.5rem, 4vw, 2.5rem);
    }
    .final-cta-mark {
        animation: float 3.6s ease-in-out infinite;
        width: clamp(4rem, 8vw, 6rem);
    }
    .final-cta-copy {
        h2 {
            font-size: clamp(1.3rem, 2.6vw, 1.9rem);
            margin: 0 0 0.45rem;
        }

        p:last-child {
            color: var(--dl-muted);
            margin: 0;
        }
    }

    @media (max-width: 52rem) {
        .hero-grid {
            grid-template-columns: 1fr;
            text-align: center;
        }
        .hero-logo {
            width: 11rem;
        }
        .hero-sub {
            margin-inline: auto;
        }
        .hero-actions {
            justify-content: center;
        }
        .bento {
            flex-direction: column;
        }
        .bento-col {
            flex: none;
        }
        .open-source {
            align-items: flex-start;
            flex-direction: column;
        }
        .final-cta {
            grid-template-columns: 1fr;
            justify-items: center;
            text-align: center;
        }
        .final-cta-mark {
            width: 5rem;
        }
    }
</style>
